# ─── Application ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Database (Supabase PostgreSQL) ────────────────────────────────────────────
# Transaction Pooler (port 6543) — used by the app at runtime
DATABASE_URL=
# Direct Connection (port 5432) — used by Prisma CLI (migrate, push, studio)
DIRECT_URL=

# ─── NextAuth v5 ───────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
# Required in production; can be omitted in development (defaults to http://localhost:3000)
NEXTAUTH_URL=http://localhost:3000

# ─── Admin seed credentials ────────────────────────────────────────────────────
ADMIN_EMAIL=admin@kens.lk
# Generate with: node -e "const b=require('bcryptjs');b.hash('yourpassword',12).then(console.log)"
ADMIN_PASSWORD_HASH=

# ─── Cloudinary ────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Resend (transactional email) ──────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@kens.lk

# ─── PayHere (Sri Lanka payment gateway) ───────────────────────────────────────
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
# Set to "true" for sandbox, "false" for production
PAYHERE_SANDBOX=true
